flowchart TB
  pr["PRs labelled train<br/>(box-green, merged with current main)"] --> tick(["Timer at :25 and :55"])
  tick --> first{"Touches JoinBudget<br/>or sim.toml?"}
  first -- yes --> alone["Rides first, alone"]
  first -- no --> batch["Merge the batch onto main"]
  alone --> batch
  batch --> chk["forge check on the box<br/>(a forge slot: 4 per box)"]
  chk -- pass --> land["Squash-merge each PR<br/>at its tested head"]:::good
  chk -- fail --> bis["Bisect: split the batch in half,<br/>check each half"]
  bis --> chk
  bis --> culprit["Culprit found: comment with the failing lines,<br/>label removed, owner fixes"]:::bad
  land --> main[("main")]
  main --> ci["CI on self-hosted box runners:<br/>static + 3 test shards"]
  classDef good fill:#1f3a2a,stroke:#7be0a0,color:#eafff1
  classDef bad fill:#4a1830,stroke:#ff6b8b,color:#ffe8ee
