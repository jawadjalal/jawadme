# ── /design brief CMS ────────────────────────────────────────────────────────
# The Supabase "Portfolio" project holds the design_briefs table. Both values
# are server-only: they are read in route handlers and server components and
# never reach the browser, so they must NOT be prefixed with NEXT_PUBLIC_.
#
# The service-role key bypasses RLS by design (the table is deny-all otherwise).
# Copy it from Supabase → Project Settings → API → service_role.
SUPABASE_URL=https://fngutktiqzrrjfviaseo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password for /design/admin. Also used as the session-cookie signing secret
# unless DESIGN_ADMIN_SECRET is set, so changing it signs everyone out.
DESIGN_ADMIN_PASSWORD=

# Optional: separate signing secret, if you want to rotate the password without
# invalidating live sessions.
# DESIGN_ADMIN_SECRET=
