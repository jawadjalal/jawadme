# The contact modal. Without RESEND_API_KEY the form does not pretend to work:
# it tells the visitor it is not connected and offers the address instead.
#
# Set these in Vercel (Project → Settings → Environment Variables), not here.
# This file is a record of what the app reads, and holds no secrets.

# From resend.com/api-keys. Sending permission is all it needs.
RESEND_API_KEY=

# Optional. Defaults to IDENTITY.email in src/lib/profile.ts.
CONTACT_TO=

# Optional. Must be a domain verified with Resend.
# Defaults to "jawadjalal.com <hello@jawadjalal.com>".
# Before jawadjalal.com is verified, use:
#   CONTACT_FROM=onboarding@resend.dev
# which delivers only to the address on the Resend account.
CONTACT_FROM=
